# Conexion a PostgreSQL de PinkyPuff.
#
# Copie este archivo a:   ~/.pinkypuff/conexion.properties
# (en Windows:            C:\Users\SU_USUARIO\.pinkypuff\conexion.properties)
#
# Tambien puede indicar otra ruta al arrancar:
#   java -Dpinkypuff.config=/ruta/conexion.properties -jar PinkyPuff.jar
#
# Si el archivo no existe, la aplicacion muestra un dialogo para rellenarlo.

db.host=localhost
db.puerto=5433
db.base=postgres
db.usuario=admin
db.password=CAMBIEME
