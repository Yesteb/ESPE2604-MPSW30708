<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
  <persistence-unit name="pinkyPuffPersistance" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>model.Cliente</class>
    <class>model.Pedido</class>
    <class>model.Producto</class>
    <class>model.EtiquetaConfig</class>
    <class>model.Administrador</class>
    <properties>
      <!-- La url, el usuario y la contrasena NO se declaran aqui a proposito:
           los aporta utils.ConfiguracionBD en tiempo de ejecucion, leyendolos de
           ~/.pinkypuff/conexion.properties. Asi el JAR distribuido no lleva
           credenciales dentro y se puede apuntar a otro servidor sin recompilar. -->
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>

      <!-- Registro de SQL: util al depurar, caro en uso normal -->
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="false"/>

      <!-- Pool de conexiones. Sin el, cada em.close() puede cerrar la conexion
           fisica y la siguiente operacion paga el coste de abrir otra. -->
      <property name="hibernate.connection.provider_class"
                value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
      <property name="hibernate.hikari.minimumIdle" value="2"/>
      <property name="hibernate.hikari.maximumPoolSize" value="10"/>
      <property name="hibernate.hikari.idleTimeout" value="30000"/>
      <property name="hibernate.hikari.connectionTimeout" value="10000"/>

      <!-- Agrupa INSERT/UPDATE en lotes: menos viajes a la base de datos -->
      <property name="hibernate.jdbc.batch_size" value="30"/>
      <property name="hibernate.order_inserts" value="true"/>
      <property name="hibernate.order_updates" value="true"/>
      <property name="hibernate.jdbc.fetch_size" value="100"/>
    </properties>
  </persistence-unit>
</persistence>
