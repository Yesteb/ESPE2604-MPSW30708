<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.crsm_procesos</groupId>
    <artifactId>mavenproject1</artifactId>
    <version>1.0-PinkyPuff</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <exec.mainClass>view.FrmLogin</exec.mainClass>
        <javafx.version>21.0.8</javafx.version>
    </properties>
    <dependencies>

    <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>7.0.0.Final</version>
    </dependency>

    <!-- Pool de conexiones usado desde persistence.xml -->
    <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-hikaricp</artifactId>
        <version>7.0.0.Final</version>
    </dependency>

    <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.7</version>
    </dependency>
    <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>1.18.42</version>
        <scope>provided</scope>
    </dependency>
    <dependency>
        <groupId>com.github.librepdf</groupId>
        <artifactId>openpdf</artifactId>
        <version>1.3.43</version>
    </dependency>
    <dependency>
        <groupId>com.formdev</groupId>
        <artifactId>flatlaf</artifactId>
        <version>3.7.1</version>
    </dependency>
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-swing</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
    </dependency>
</dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.7</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- JAR unico ejecutable: se lanza con `java -jar PinkyPuff.jar`.
                 Se usa shade y no assembly porque Hibernate depende de que los
                 archivos META-INF/services de sus multiples jars se FUSIONEN;
                 con assembly el ultimo sobrescribe a los anteriores y el
                 arranque falla. De eso se encarga ServicesResourceTransformer. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>PinkyPuff</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>view.FrmLogin</mainClass>
                                </transformer>
                                <!-- Fusiona los META-INF/services de Hibernate, el driver JDBC, etc. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Las firmas de los jars originales dejan de ser validas
                                             al refundirlos: sin excluirlas, Java rechaza el JAR. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Descriptores de modulo: el JAR se ejecuta por classpath -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- ============================================================
             Distribucion para Windows:  mvn clean package -Pdist-windows
             ============================================================
             De todas las dependencias, la unica que trae binarios por sistema
             operativo es JavaFX: FlatLaf ya empaqueta los DLL de Windows junto
             a los .so de Linux en un mismo jar, y el driver de PostgreSQL y
             OpenPDF son Java puro.

             Por eso basta con anadir los artefactos JavaFX con clasificador
             "win". Conviven con los de Linux dentro del mismo JAR (las clases
             son identicas y los nativos tienen nombres distintos), asi que el
             resultado funciona en ambos sistemas sin perder nada.
             ============================================================ -->
        <profile>
            <id>dist-windows</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-swing</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- Envuelve el JAR en un .exe nativo de Windows. El plugin
                         trae sus propios binarios, asi que puede generarse desde
                         Linux sin necesidad de una maquina Windows. -->
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.5.2</version>
                        <executions>
                            <execution>
                                <id>exe-windows</id>
                                <phase>package</phase>
                                <goals><goal>launch4j</goal></goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <jar>${project.build.directory}/PinkyPuff.jar</jar>
                                    <outfile>${project.build.directory}/PinkyPuff.exe</outfile>
                                    <downloadUrl>https://adoptium.net/temurin/releases/?version=21</downloadUrl>
                                    <errTitle>PinkyPuff</errTitle>
                                    <classPath>
                                        <mainClass>view.FrmLogin</mainClass>
                                    </classPath>
                                    <jre>
                                        <!-- Usa el Java instalado; si falta o es
                                             antiguo, abre la pagina de descarga. -->
                                        <minVersion>21</minVersion>
                                        <requiresJdk>false</requiresJdk>
                                        <requires64Bit>true</requires64Bit>
                                    </jre>
                                    <versionInfo>
                                        <fileVersion>1.0.0.0</fileVersion>
                                        <txtFileVersion>1.0</txtFileVersion>
                                        <fileDescription>PinkyPuff - gestion de pedidos</fileDescription>
                                        <copyright>PinkyPuff</copyright>
                                        <productVersion>1.0.0.0</productVersion>
                                        <txtProductVersion>1.0</txtProductVersion>
                                        <productName>PinkyPuff</productName>
                                        <internalName>PinkyPuff</internalName>
                                        <originalFilename>PinkyPuff.exe</originalFilename>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>javafx-linux</id>
            <activation>
                <os><family>unix</family><name>linux</name></os>
            </activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
    </profiles>
</project>