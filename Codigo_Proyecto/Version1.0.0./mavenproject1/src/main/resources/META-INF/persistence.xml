<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
  <persistence-unit name="pinkyPuffPersistance" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>model.Usuario</class>
    <properties>
      <property name="jakarta.persistence.jdbc.url"      value="jdbc:postgresql://localhost:5433/postgres"/>
      <property name="jakarta.persistence.jdbc.user"     value="admin"/>
      <property name="jakarta.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value="contra"/>
      <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
      <property name="hibernate.show_sql"                value="true"/>
      <property name="hibernate.format_sql"              value="true"/>
    </properties>
  </persistence-unit>
</persistence>
